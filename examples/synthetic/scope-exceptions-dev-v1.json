        {
          "session_id": "scope-dev-01-s1",
          "message_id": "scope-dev-case-01-m01",
          "role": "user",
          "text": "At the Copperleaf archive, I use the west vestibule for ordinary catalog visits.",
          "recorded_at": "2026-03-02T09:00:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-01-s1",
          "message_id": "scope-dev-case-01-m02",
          "role": "assistant",
          "text": "What route do you take with oversized map tubes?",
          "recorded_at": "2026-03-02T09:07:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-01-s2",
          "message_id": "scope-dev-case-01-m03",
          "role": "user",
          "text": "Whenever I carry an oversized map tube, I use the north loading door instead; I have taken it on every tube-carrying visit this month.",
          "recorded_at": "2026-03-18T09:14:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-01-s2",
          "message_id": "scope-dev-case-01-m04",
          "role": "assistant",
          "text": "Is the west vestibule still your normal route without a tube?",
          "recorded_at": "2026-03-18T09:21:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-01-s2",
          "message_id": "scope-dev-case-01-m05",
          "role": "user",
          "text": "Yes, for an ordinary catalog visit without the tube I still enter through the west vestibule.",
          "recorded_at": "2026-03-18T09:28:00Z",
          "content_kind": "conversation"
        }
      ],
