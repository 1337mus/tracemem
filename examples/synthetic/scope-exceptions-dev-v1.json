      "messages": [
        {
          "session_id": "scope-dev-02-s1",
          "message_id": "scope-dev-case-02-m01",
          "role": "user",
          "text": "The Fenwick Instrument Library handbook has a route rule for returned packages.",
          "recorded_at": "2026-04-06T10:00:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-02-s1",
          "message_id": "scope-dev-case-02-m02",
          "role": "assistant",
          "text": "Does that describe how you handle returns?",
          "recorded_at": "2026-04-06T10:07:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-02-s2",
          "message_id": "scope-dev-case-02-m03",
          "role": "user",
          "text": "The handbook says, “Staff use the blue intake for non-damp returns; if a parcel is damp, staff use the sealed drying bay instead.” I am quoting its text, not describing my own routine.",
          "recorded_at": "2026-04-20T10:14:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-02-s2",
          "message_id": "scope-dev-case-02-m04",
          "role": "assistant",
          "text": "So is that your personal route?",
          "recorded_at": "2026-04-20T10:21:00Z",
          "content_kind": "conversation"
        },
        {
          "session_id": "scope-dev-02-s2",
          "message_id": "scope-dev-case-02-m05",
          "role": "user",
          "text": "No. I do not handle their intake; I only transcribed the handbook rule.",
          "recorded_at": "2026-04-20T10:28:00Z",
          "content_kind": "conversation"
        }
      ],
      "expected": [
        {
          "subject": "the Fenwick Instrument Library handbook",
          "predicate": "REPORTS",
          "object": "staff use the blue intake for non-damp returns and the sealed drying bay for damp parcels",
          "speaker_role": "user",
          "attribution": "quoted_text",
          "modality": "reported",
          "polarity": "positive",
          "valid_from": null,
          "valid_to": null,
          "evidence": [
            {
              "session_id": "scope-dev-02-s2",
              "message_id": "scope-dev-case-02-m03",
              "char_start": 20,
              "char_end": 129,
              "quote": "Staff use the blue intake for non-damp returns; if a parcel is damp, staff use the sealed drying bay instead."
            }
          ]
        }
      ]
    },
