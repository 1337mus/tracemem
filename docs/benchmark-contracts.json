  "contracts": {
    "LongMemEval": {
      "readme_assertions": [
        "The README describes 500 records per release variant, six question types, abstention IDs with an _abs suffix, answer_session_ids, and turn has_answer labels.",
        "The README describes S as about 115k history tokens, M as about 500 sessions, and oracle as evidence sessions only."
      ],
      "code_verified": [
        "QA inputs are hypothesis rows with question_id and hypothesis, joined to reference question, answer, and question_type.",
        "The evaluator has GPT-4o, GPT-4o-mini, and local Llama 3.1 70B judge aliases. Prompts use yes/no judgments, with special temporal, knowledge-update, preference, and abstention instructions.",
        "The judge runs at temperature 0 with max_tokens 10. Any case-insensitive occurrence of the substring yes marks correct.",
        "QA aggregation reports by type, task average, overall, and abstention accuracy, and asserts the judge model is GPT-4o 2024-08-06.",
        "Retrieval excludes IDs containing _abs and reports session recall_all/NDCG at 5 and 10, plus turn recall_all/NDCG at 5, 10, and 50. Retrieval helpers define any/all evidence recall, binary relevance NDCG, and turn-to-session projection.",
        "DCG leaves the first item undiscounted, then divides later items by log2(2), log2(3), ...; positions one and two both have weight 1. Turn-to-session projection expands the ranked prefix to k unique sessions or corpus exhaustion, but retains repeated session IDs for NDCG."
      ],
      "license_observation": "The pinned repository LICENSE is MIT. Dataset-specific rights were not established by this source review.",
      "unresolved": [
        "No dataset variant or field values were inspected.",
        "No quality result or compatibility claim was established."
      ]
    },
    "LoCoMo": {
      "readme_assertions": [
        "The README describes ten conversations and a sample schema with sessions, timestamps, speakers, dialogue IDs, QA category, and evidence dialogue IDs.",
        "The README describes QA over truncated conversations and RAG over dialogue, observation, or session-summary databases.",
        "The README says image files are not released, while image URLs, captions, and search queries are included."
      ],
      "code_verified": [
        "The runner reads a JSON list of samples and invokes the selected system-under-test model family. The evaluator does not call a separate LLM judge.",
        "Answer scores use normalized, Porter-stemmed token F1. Categories 2, 3, and 4 use single-string F1; category 1 uses comma-split multi-answer F1; category 3 truncates the answer at its first semicolon; category 5 accepts either no-information phrase.",
        "Evidence recall compares returned context IDs to annotated evidence at session or dialogue granularity. If the context key is absent or the evidence list is empty, the scorer appends recall 1.",
        "The aggregate overall score is count-weighted across categories.",
        "A present empty context list with nonempty evidence raises at context[0]. The runner rounds per-answer F1 and recall to three decimals before aggregation."
      ],
      "license_observation": "The pinned LICENSE.txt is Creative Commons Attribution-NonCommercial 4.0 International. Rights for every conversation, persona, caption, and external image were not established.",
      "unresolved": [
